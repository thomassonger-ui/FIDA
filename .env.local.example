# Copy to .env.local for local dev. Set these same keys as Production env
# vars in Vercel for the deployed site.

# --- Anthropic (Atticus) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (FIDA: tickets, atticus logs, demo data) ---
# Canonical project ref: pljgraqphhmsbscpvhbm
SUPABASE_URL=https://pljgraqphhmsbscpvhbm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
NEXT_PUBLIC_SUPABASE_URL=https://pljgraqphhmsbscpvhbm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Admin dashboard auth ---
# ADMIN_PASSWORD is what you type at /login
# ADMIN_SESSION_SECRET is the cookie value (generate: openssl rand -hex 32)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Atticus UI ---
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/thomas-songer/cole-middleton-advisors

# --- Moodle integration (server-to-server) ---
# Create token in Moodle: Site admin -> Plugins -> Web services -> Manage tokens
MOODLE_URL=https://fldentalassisting.moodlecloud.com
MOODLE_TOKEN=

# --- Site URL (used in magic-link emails to send students back to the right host) ---
NEXT_PUBLIC_SITE_URL=https://fida-eight.vercel.app

# --- Site gate (public-facing password wall before login) ---
# Set this in Vercel for production. Local dev falls back to 'atticus2026' if unset.
SITE_PASSWORD=

# --- Prospecting: daily outreach caps ---
# Warm-up settings, not permanent ceilings. Raise them here (and in Vercel) as
# the sending domain earns its reputation — see RAMP in lib/prospects-shared.ts.
# Omit either one to fall back to 10.
PROSPECT_DAILY_EMAIL_LIMIT=10
PROSPECT_DAILY_SKIP_TRACE_LIMIT=10

# --- Prospecting: drip email (Resend) ---
# Domain fldentalassisting.com must be verified in Resend (DKIM + send. SPF/MX
# records live in Vercel DNS). reply@ is a real Google Workspace mailbox so
# replies land with a person.
RESEND_API_KEY=re_...
DRIP_FROM="FIDA Admissions <reply@fldentalassisting.com>"
# Optional — only if replies should go somewhere other than DRIP_FROM
DRIP_REPLY_TO=
# Signs unsubscribe links (openssl rand -hex 32). Falls back to ADMIN_SESSION_SECRET.
UNSUBSCRIBE_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/drip (openssl rand -hex 32).
# Vercel reads the name CRON_SECRET automatically.
CRON_SECRET=
